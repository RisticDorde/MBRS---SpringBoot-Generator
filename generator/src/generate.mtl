[module generate('http://www.eclipse.org/uml2/5.0.0/UML')]
[import utils::umlHelpers /]
[import templates::entity /]
[import templates::repository /]
[import templates::dto /]
[import templates::mapper /]
[import templates::service /]
[import templates::controller /]

[template public generateAll(model : Model)]
[comment @main/]
[for (c : Class | model.eAllContents(Class))]
    [if (c.hasStereotype('Entity'))]
        [c.generateEntity()/]
        [c.generateRepository()/]
        [c.generateDto()/]
        [c.generateMapper()/]
        [c.generateService()/]
        [c.generateController()/]
    [/if]
[/for]
[/template]
